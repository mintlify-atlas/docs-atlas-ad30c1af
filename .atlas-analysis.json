  "keyFeatures": [
    "Grounded answers from the Backstage catalog and TechDocs — no hallucinated facts",
    "Backstage actions run as the signed-in user with their own permissions",
    "MCP server integration: shared credential or per-user token (GitHub, Microsoft, OAuth)",
    "Client tools contributed by any frontend plugin, running in the browser as the user",
    "Approval gate: Allow / Always allow / Deny before any write tool executes",
    "Semantic + fuzzy + keyword knowledge index via pgvector and pg_trgm",
    "Floating panel that reads the page it sits beside via read_current_page",
    "Homepage composer in four looks; scaffolder template forms rendered inline in chat",
    "Generative UI: inline RJSF forms, Mermaid diagrams, download chips",
    "In-app admin editor — no config file required for assistant definitions",
    "Supports OpenAI, Anthropic, Azure OpenAI, and any OpenAI-compatible endpoint"
  ],
  "publicApiSurface": [
    "assistantsPlugin (default export from @drewswiredin/backstage-plugin-assistants/alpha)",
    "assistantsPanelModule",
    "assistantsHomeModule",
    "AssistantComposer (component)",
    "AssistantClientToolBlueprint",
    "clientToolDataRef",
    "clientToolsApiRef / ClientToolsApi",
    "assistantsApiRef / AssistantsApi",
    "AssistantsNavIcon",
    "usePanelControl",
    "rootRouteRef / threadRouteRef",
    "assistantUsePermission / assistantManagePermission (from -common)",
    "assistantsModelProvidersExtensionPoint (backend)",
    "knowledgeRankingExtensionPoint (from -backend-module-semantic-search/alpha)",
    "GET /api/assistants/status",
    "POST /api/assistants/chat",
    "GET /api/assistants/chat/resume/:threadId",
    "POST /api/assistants/chat/cancel/:threadId",
    "GET /api/assistants/threads",
    "POST /api/assistants/threads",
    "GET /api/assistants/threads/:id",
    "PATCH /api/assistants/threads/:id",
    "DELETE /api/assistants/threads/:id",
    "GET /api/assistants/capabilities",
    "GET /api/assistants/manage/assistants",
    "POST /api/assistants/manage/assistants",
    "PUT /api/assistants/manage/assistants/:id",
    "DELETE /api/assistants/manage/assistants/:id",
    "PUT /api/assistants/manage/assistants/:id/default"
  ]
}
