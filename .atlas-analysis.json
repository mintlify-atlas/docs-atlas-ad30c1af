{
  "projectType": "framework",
  "projectName": "Backstage Assistants",
  "projectDescription": "A set of Backstage plugins that embed AI assistants directly into your developer portal, grounding every answer in your catalog and TechDocs and running every Backstage action as the signed-in user.",
  "theme": "luma",
